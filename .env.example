# Optional: T0 Connect source builds
# t0: T0 Connect only works against a relay and Clerk instance you deploy yourself
# (see infra/relay). Upstream's production values were removed from this file so a
# copied .env never connects this fork to T3 Tools' servers (TELEMETRY-REGISTER.md T0-HOME-02).
# Do not add server-side secrets to this file.

# Your Clerk instance: Clerk Dashboard > API keys, JWT templates, and OAuth applications.
# T0CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# T0CODE_CLERK_JWT_TEMPLATE=...
# T0CODE_CLERK_CLI_OAUTH_CLIENT_ID=...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T0CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T0CODE_APPLE_TEAM_ID=ABC1234567
# T0CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t0code.provisionprofile
# T0CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your self-hosted relay. `infra/relay` deploys update it automatically.
# T0CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# T0CODE_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# T0CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T0CODE_MOBILE_OTLP_TRACES_DATASET=t0-code-mobile-traces-dev
# T0CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
